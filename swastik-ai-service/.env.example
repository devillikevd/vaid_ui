# Swastik AI Service — FastAPI Consultation AI
GROQ_API_KEY=your_groq_api_key
HUGGINGFACE_API_KEY=your_hf_api_key

# MongoDB (same as backend)
MONGODB_URI=your_mongodb_uri
MONGODB_DB_NAME=swastik_healthcare

# Redis (Upstash)
REDIS_URL=your_redis_url

# Service config
AI_SERVICE_PORT=8000
AI_SERVICE_WORKERS=2
AI_SERVICE_RELOAD=false
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.3

# Node backend URL (for verifying JWT tokens)
BACKEND_URL=http://localhost:5001

# JWT verification secret (must match backend access-token signing secret)
# Preferred: JWT_ACCESS_SECRET. Fallback: JWT_SECRET.
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_SECRET=your_jwt_secret
