# Swastik AI Service — FastAPI Consultation AI
GROQ_API_KEY=your_groq_api_key
HUGGINGFACE_API_KEY=your_hf_api_key

# MongoDB (same as backend)
MONGODB_URI=your_mongodb_uri
MONGODB_DB_NAME=swastik_healthcare

# Redis (Upstash)
REDIS_URL=your_redis_url

# Service config
AI_SERVICE_PORT=8000
AI_SERVICE_WORKERS=2
AI_SERVICE_RELOAD=false
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.3

# Node backend URL (for verifying session ownership before opening WebSockets)
BACKEND_URL=http://localhost:5001

# JWT verification (CVE-002 — do NOT share the backend access-token secret).
# Preferred (production): JWT_AI_SERVICE_SECRET — a dedicated key that the
# backend signs short-lived aiServiceToken's with. Generate with:
#   openssl rand -hex 64
# Legacy fallback (transitional only): JWT_ACCESS_SECRET / JWT_SECRET.
JWT_AI_SERVICE_SECRET=your_ai_service_jwt_secret
JWT_AI_SERVICE_AUDIENCE=swastik-ai-service
JWT_AUDIENCE=swastik-backend
JWT_ISSUER=swastik-backend

# H006: strict CORS allowlist (comma-separated). Defaults to the frontend URLs
# below when unset. Must NEVER be "*" with credentials.
AI_SERVICE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_WEB_URL=http://localhost:3000
FRONTEND_DOCTOR_WEB_URL=http://localhost:3001

# H007: optional secret that unlocks verbose /health diagnostics.
# HEALTHCHECK_SECRET=change-me

# CVE-003: WebSocket connect throttling (per IP per window).
WS_CONNECT_RATE_LIMIT=20
WS_CONNECT_RATE_WINDOW=60
