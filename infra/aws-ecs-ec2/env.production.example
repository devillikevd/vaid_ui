# Copy to env.production and fill real production values.
# This file is intentionally gitignored.

SUPABASE_ANON_KEY=change-me
SUPABASE_SERVICE_ROLE_KEY=change-me

JWT_SECRET=change-me-minimum-32-chars
JWT_ACCESS_SECRET=change-me-minimum-32-chars
JWT_REFRESH_SECRET=change-me-minimum-32-chars

# Use Upstash/Redis Cloud/ElastiCache URL. Required for Socket.IO scaling and cron locks.
REDIS_URL=rediss://default:password@host:6379
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=change-me

MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/swastik_healthcare

GROQ_API_KEY=change-me
HUGGINGFACE_API_KEY=change-me

GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
EMAIL_FROM_ADDRESS=noreply@vaididea.in

# Optional push notifications. Base64 encode the Firebase service-account JSON.
# macOS: base64 -i firebase-service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=change-me
