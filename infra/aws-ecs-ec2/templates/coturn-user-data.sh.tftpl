#!/bin/bash
set -euxo pipefail

dnf update -y
dnf install -y docker certbot
systemctl enable --now docker

mkdir -p /opt/coturn/certs

# Self-signed certs keep coturn bootable before DNS and Let's Encrypt are ready.
# Real TLS certs are fetched into /etc/letsencrypt once turn_domain_name resolves
# to this instance's public IP.
SELF_SIGNED_CN="${turn_domain_name}"
if [ -z "$SELF_SIGNED_CN" ]; then
  SELF_SIGNED_CN="turn.local"
fi
if [ ! -s /opt/coturn/certs/fullchain.pem ] || [ ! -s /opt/coturn/certs/privkey.pem ]; then
  openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
    -keyout /opt/coturn/certs/privkey.pem \
    -out /opt/coturn/certs/fullchain.pem \
    -subj "/CN=$SELF_SIGNED_CN"
fi
chmod 644 /opt/coturn/certs/fullchain.pem /opt/coturn/certs/privkey.pem

cat > /opt/coturn/render-config.sh <<'SCRIPT'
#!/bin/bash
set -euo pipefail

TURN_DOMAIN='${turn_domain_name}'
CONFIG=/opt/coturn/turnserver.conf
TMP="$CONFIG.tmp"

TOKEN="$(curl -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")"
PUBLIC_IP="$(curl -H "X-aws-ec2-metadata-token: $TOKEN" -fsS http://169.254.169.254/latest/meta-data/public-ipv4 || true)"
PRIVATE_IP="$(curl -H "X-aws-ec2-metadata-token: $TOKEN" -fsS http://169.254.169.254/latest/meta-data/local-ipv4 || true)"

REGION="$(curl -H "X-aws-ec2-metadata-token: $TOKEN" -fsS http://169.254.169.254/latest/meta-data/placement/region || true)"
TURN_SECRET="$(aws ssm get-parameter --name "/swastik/turn/secret" --with-decryption --region "$REGION" --query "Parameter.Value" --output text || echo "default-secret")"

cat > "$TMP" <<'CONF'
listening-port=3478
min-port=${turn_min_port}
max-port=${turn_max_port}
fingerprint
lt-cred-mech
realm=${turn_realm}
server-name=${turn_realm}
use-auth-secret
static-auth-secret=$TURN_SECRET
total-quota=${turn_total_quota}
stale-nonce=600
no-cli
no-multicast-peers
no-loopback-peers
log-file=stdout
simple-log
CONF

if [ -n "$TURN_DOMAIN" ]; then
  LE_CERT_PATH="/etc/letsencrypt/live/$TURN_DOMAIN/fullchain.pem"
  LE_KEY_PATH="/etc/letsencrypt/live/$TURN_DOMAIN/privkey.pem"
  CERT_PATH="/opt/coturn/certs/turn-fullchain.pem"
  KEY_PATH="/opt/coturn/certs/turn-privkey.pem"
  if [ -s "$LE_CERT_PATH" ] && [ -s "$LE_KEY_PATH" ]; then
    cp -f "$LE_CERT_PATH" "$CERT_PATH"
    cp -f "$LE_KEY_PATH" "$KEY_PATH"
    chmod 644 "$CERT_PATH" "$KEY_PATH"
  else
    CERT_PATH="/opt/coturn/certs/fullchain.pem"
    KEY_PATH="/opt/coturn/certs/privkey.pem"
    chmod 644 "$CERT_PATH" "$KEY_PATH"
  fi
  {
    echo "tls-listening-port=5349"
    echo "cert=$CERT_PATH"
    echo "pkey=$KEY_PATH"
  } >> "$TMP"
else
  {
    echo "no-tls"
    echo "no-dtls"
  } >> "$TMP"
fi

if [ -n "$PUBLIC_IP" ] && [ -n "$PRIVATE_IP" ]; then
  echo "external-ip=$PUBLIC_IP/$PRIVATE_IP" >> "$TMP"
elif [ -n "$PUBLIC_IP" ]; then
  echo "external-ip=$PUBLIC_IP" >> "$TMP"
fi

if ! cmp -s "$TMP" "$CONFIG" 2>/dev/null; then
  mv "$TMP" "$CONFIG"
  echo changed
else
  rm -f "$TMP"
  echo unchanged
fi
SCRIPT
chmod +x /opt/coturn/render-config.sh

cat > /opt/coturn/reload-if-config-changed.sh <<'SCRIPT'
#!/bin/bash
set -euo pipefail

CHANGE="$(/opt/coturn/render-config.sh)"
if [ "$CHANGE" = "changed" ] && docker ps -a --format '{{.Names}}' | grep -qx coturn; then
  docker restart coturn
fi
SCRIPT
chmod +x /opt/coturn/reload-if-config-changed.sh

cat > /opt/coturn/get-cert.sh <<'SCRIPT'
#!/bin/bash
set -euo pipefail

TURN_DOMAIN='${turn_domain_name}'
if [ -z "$TURN_DOMAIN" ]; then
  exit 0
fi

TOKEN="$(curl -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")"
PUBLIC_IP="$(curl -H "X-aws-ec2-metadata-token: $TOKEN" -fsS http://169.254.169.254/latest/meta-data/public-ipv4 || true)"
RESOLVED_IP="$(getent ahostsv4 "$TURN_DOMAIN" | awk 'NR == 1 { print $1 }' || true)"

if [ -n "$PUBLIC_IP" ] && [ -n "$RESOLVED_IP" ] && [ "$PUBLIC_IP" != "$RESOLVED_IP" ]; then
  echo "Skipping certbot: $TURN_DOMAIN resolves to $RESOLVED_IP, instance public IP is $PUBLIC_IP"
  exit 0
fi

certbot certonly --standalone \
  -d "$TURN_DOMAIN" \
  --non-interactive \
  --agree-tos \
  -m admin@vaididea.in \
  --keep-until-expiring

/opt/coturn/render-config.sh >/dev/null
docker restart coturn || true
SCRIPT
chmod +x /opt/coturn/get-cert.sh

mkdir -p /etc/letsencrypt/renewal-hooks/deploy
cat > /etc/letsencrypt/renewal-hooks/deploy/restart-coturn.sh <<'SCRIPT'
#!/bin/bash
/opt/coturn/reload-if-config-changed.sh || docker restart coturn || true
SCRIPT
chmod +x /etc/letsencrypt/renewal-hooks/deploy/restart-coturn.sh

/opt/coturn/render-config.sh >/dev/null

docker rm -f coturn || true
docker run -d \
  --name coturn \
  --network host \
  --restart unless-stopped \
  -v /opt/coturn/turnserver.conf:/etc/coturn/turnserver.conf:ro \
  -v /opt/coturn/certs:/opt/coturn/certs:ro \
  -v /etc/letsencrypt:/etc/letsencrypt:ro \
  coturn/coturn:4.6 \
  -c /etc/coturn/turnserver.conf

cat > /etc/systemd/system/coturn-refresh.service <<'EOF'
[Unit]
Description=Refresh coturn AWS external IP mapping
After=docker.service

[Service]
Type=oneshot
ExecStart=/opt/coturn/reload-if-config-changed.sh
EOF

cat > /etc/systemd/system/coturn-refresh.timer <<'EOF'
[Unit]
Description=Refresh coturn AWS external IP mapping periodically

[Timer]
OnBootSec=2min
OnUnitActiveSec=2min
Unit=coturn-refresh.service

[Install]
WantedBy=timers.target
EOF

systemctl daemon-reload
systemctl enable --now coturn-refresh.timer

/opt/coturn/get-cert.sh || true
