project_name = "swastik"
environment  = "prod"
aws_region   = "ap-south-1"

# Start cheap. Increase after monitoring/load test.
instance_type         = "t4g.medium"
ec2_min_size          = 1
ec2_desired_capacity  = 1
ec2_max_size          = 4
app_min_tasks         = 1
app_desired_tasks     = 1
app_max_tasks         = 8
ai_service_workers    = 1
log_retention_days    = 14

# Low-cost coturn server for video consultation fallback.
# TURN relay bandwidth can become expensive, so keep it as fallback only.
turn_enabled       = true
turn_instance_type = "t4g.nano"
turn_realm         = "vaididea.in"
turn_username      = "vaididea-turn"
turn_password      = "replace-with-a-strong-turn-password"
turn_total_quota   = 500

# Set these before production CORS goes live.
frontend_web_url        = "https://vaididea.in"
frontend_doctor_web_url = "https://vaididea.in"
frontend_app_url        = "exp://your-app-url"
supabase_url            = "https://your-project.supabase.co"

# Optional: use ACM cert if you want HTTPS directly on ALB.
# certificate_arn = "arn:aws:acm:ap-south-1:123456789012:certificate/..."

# Optional: route a dedicated AI domain to the AI container.
# ai_domain_names = ["ai.yourdomain.com"]

# Optional: enable GitHub Actions CI/CD role.
# github_oidc_enabled = true
# github_repository   = "nayanpr620/SWASTIK-TELEMEDICINE"
# github_branch       = "main"
