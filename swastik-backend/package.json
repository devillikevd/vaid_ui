{
  "name": "swastik-backend",
  "version": "1.0.0",
  "description": "VAIDIDEA Healthcare Backend API - Complete healthcare platform for patients and doctors",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup:minio": "node scripts/setup-minio.js",
    "setup:storage": "node scripts/setup-minio.js",
    "test": "jest --passWithNoTests",
    "test:access-policy": "jest --runInBand __tests__/access-policy.sync.test.js",
    "test:provider-discovery": "node scripts/verify-provider-discovery.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:load:public": "k6 run load-tests/wellness-public.js",
    "test:load:auth": "k6 run load-tests/wellness-authenticated.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "healthcare",
    "telemedicine",
    "doctor",
    "patient",
    "ambulance",
    "hospital"
  ],
  "author": "VAIDIDEA Healthcare",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1024.0",
    "@aws-sdk/s3-request-presigner": "^3.1024.0",
    "@google/genai": "^1.10.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.39.0",
    "@upstash/redis": "^1.36.2",
    "archiver": "^8.0.0",
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.71.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "file-type": "^21.3.2",
    "firebase-admin": "^14.2.0",
    "geolib": "^3.3.4",
    "helmet": "^7.1.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.7",
    "mongoose": "^9.1.6",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.1",
    "pdfkit": "^0.17.2",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "ajv": "^8.18.0",
    "eslint": "^10.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "pg": "^8.23.0",
    "playwright": "^1.59.1",
    "socket.io-client": "^4.8.3"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.6",
    "uuid": "11.1.1"
  }
}
