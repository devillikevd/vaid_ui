# Environment Variables for Swastik Healthcare Backend

# Server Configuration
NODE_ENV=development
PORT=5001

# Supabase Configuration (Authentication & Database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-chars
JWT_ACCESS_SECRET=your-access-token-secret-optional
JWT_REFRESH_SECRET=your-refresh-token-secret-optional
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
# CVE-002: dedicated secret for the FastAPI AI service. When set, the backend
# mints a short-lived aiServiceToken signed with this secret and the AI service
# verifies against it (no shared signing key with the main access token).
# Required in production — generate with: openssl rand -hex 64
JWT_AI_SERVICE_SECRET=your-ai-service-jwt-secret
JWT_AI_SERVICE_EXPIRES_IN=15m
JWT_AUDIENCE=swastik-backend
JWT_AI_SERVICE_AUDIENCE=swastik-ai-service
JWT_ISSUER=swastik-backend

# CVE-001: enforce Row Level Security by running authenticated requests through
# per-user Supabase clients. Requires the 059_security_rls_hardening.sql
# migration and the Supabase project JWT secret set to JWT_ACCESS_SECRET.
# USE_PER_REQUEST_SUPABASE=true

# L004: comma-separated IPs and/or IPv4 CIDRs of trusted reverse proxies (e.g.
# AWS ALB subnet CIDRs). X-Forwarded-For is only honored for these peers and
# req.ip is set from it. Leave unset to ignore X-Forwarded-For entirely.
# TRUSTED_PROXY_IPS=10.0.0.0/16,203.0.113.5

# L015: require MFA on admin/super_admin routes. Access tokens must carry an
# `mfa` claim (issued after a TOTP challenge) or admins are rejected with
# MFA_REQUIRED. Off by default until TOTP enrollment exists.
# ADMIN_MFA_REQUIRED=true

# H007: optional shared secret that gates verbose /health diagnostics.
# HEALTHCHECK_SECRET=change-me


# AI service URL
AI_SERVICE_URL=http://localhost:8000

# Object Storage Configuration
# Local/dev: keep STORAGE_PROVIDER=minio
# Production: set STORAGE_PROVIDER=s3 and fill the AWS/S3 values below
STORAGE_PROVIDER=minio
STORAGE_AUTO_CREATE_BUCKET=true
STORAGE_SIGNED_URL_EXPIRY_SECONDS=3600
STORAGE_SIGNED_READ_URL_EXPIRY_SECONDS=86400
STORAGE_SIGNED_UPLOAD_URL_EXPIRY_SECONDS=3600
STORAGE_PUBLIC_READ_PREFIXES=profiles/*,documents/*,reports/*,prescriptions/*,videos/*,licenses/*,entities/*,thumbnails/*,medium/*

# MinIO / local object storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=swastik-healthcare
MINIO_PUBLIC_URL=http://localhost:9000/swastik-healthcare

# Amazon S3 / production object storage
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-s3-bucket-name
S3_PUBLIC_URL=https://your-s3-bucket-name.s3.ap-south-1.amazonaws.com

# OpenAI Configuration (for Medical Chatbot)
OPENAI_API_KEY=your-openai-api-key

# Redis Configuration
# Option A: Upstash REST (preferred for serverless)
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Option B: Standard Redis URL (used by AI service and backend fallback)
REDIS_URL=redis://localhost:6379

# Email Configuration (Gmail SMTP via Nodemailer)
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
EMAIL_FROM_NAME=Swastik Healthcare
EMAIL_FROM_ADDRESS=noreply@swastik.health
FROM_EMAIL=noreply@swastik.com

# Firebase Admin Configuration (for Push Notifications via FCM)
# Required by notificationService.js:
# Provide absolute path to your Firebase service-account JSON file.
FIREBASE_SERVICE_ACCOUNT=/absolute/path/to/firebase-service-account.json

# Optional legacy Firebase fields (kept for compatibility with old setups)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# Reminder/Notification Scheduler
# Runs once per minute in server.js to send medicine + appointment reminders.
# Keep enabled in normal environments.
REMINDER_CRON_ENABLED=true

# Wellness Badges Cron (daily evaluation of workout/challenge badges)
# Manual re-run available: POST /api/wellness/admin/badges/re-evaluate
WELLNESS_BADGES_CRON_ENABLED=true
WELLNESS_BADGES_CRON_INTERVAL_MS=86400000

# Wellness Chat Retention Cleanup (daily purge of old chat messages)
# Messages older than WELLNESS_CHAT_RETENTION_DAYS are deleted in batches (5000/batch, max 100 batches).
WELLNESS_CHAT_CLEANUP_ENABLED=true
WELLNESS_CHAT_CLEANUP_INTERVAL_MS=86400000
WELLNESS_CHAT_RETENTION_DAYS=180

# Cron Alerting (all backend cron jobs)
# Every cron job (appointment-expire, consultation-timeout, reminder-notifications,
# wellness-badges, wellness-chat-cleanup, outbreak-analysis) sends failure alerts to
# CRON_ALERT_WEBHOOK_URL when it is set, and logs the failure otherwise.
# CRON_ALERT_ON_SUCCESS=true additionally alerts on every successful run (recommended: leave unset/false).
CRON_ALERT_WEBHOOK_URL=
CRON_ALERT_ON_SUCCESS=false

# Other scheduler toggles (default: all enabled)
BACKGROUND_JOBS_ENABLED=true
APPOINTMENT_EXPIRE_CRON_ENABLED=true
APPOINTMENT_EXPIRE_CRON_INTERVAL_MS=300000
CONSULTATION_TIMEOUT_CRON_ENABLED=true
CONSULTATION_TIMEOUT_CRON_INTERVAL_MS=600000
CONSULTATION_LIFECYCLE_CRON_ENABLED=true
CONSULTATION_LIFECYCLE_CRON_INTERVAL_MS=60000
OUTBREAK_CRON_ENABLED=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Frontend URLs (for CORS)
FRONTEND_WEB_URL=http://localhost:3000
FRONTEND_APP_URL=exp://localhost:8081

# Ambulance Tracking Configuration
AMBULANCE_LOCATION_UPDATE_INTERVAL=5000
MAX_AMBULANCE_SEARCH_RADIUS_KM=50

# Health Library Database
DATABASE_URL="postgresql://vaididea:vaididea@localhost:5433/health_library?schema=public"
GEMINI_API_KEY="your-gemini-api-key"
